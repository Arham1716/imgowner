# Example Dockerfile showing pinned packages that imgowner can track.
# Run: imgowner pins check --dockerfile examples/Dockerfile.example

FROM python:3.12-slim AS base

# OS packages with exact version pins — imgowner will detect and check these.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl=7.88.1-10+deb12u8 \
    ca-certificates=20230311 \
    openssl=3.0.11-1~deb12u1 \
 && rm -rf /var/lib/apt/lists/*

FROM base AS app

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
CMD ["python", "-m", "myapp"]
