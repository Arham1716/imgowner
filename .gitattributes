# The dashboard's sources are rebuilt in CI on Linux and compared byte-for-byte
# with the committed bundle, so neither may be rewritten by line-ending
# conversion on a contributor's machine.
web/dashboard/** text eol=lf
internal/dashboard/dist/** -text

# Shell and Python helpers run on Linux runners; a CRLF would break their shebang lines.
*.sh text eol=lf
.github/scripts/** text eol=lf
